# Copy this file to `.streamlit/secrets.toml` and fill in what you need.
# secrets.toml is git-ignored — never commit real secrets.

# Optional access passcode for the shared internal link (recommended).
# If set, visitors must enter it before using the app. Remove/leave blank for open access.
KAIROS_APP_PASSWORD = ""

# Only needed if you run WITHOUT the local `claude` CLI (e.g. the Anthropic API backend).
# Internal self-hosting normally uses the CLI and does NOT need this.
# KAIROS_MODEL_BACKEND = "api"
# ANTHROPIC_API_KEY = ""
